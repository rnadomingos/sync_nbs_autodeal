#PARAM TO START THE FIRST EXECUTION
INTEGRATION_START_DATE='2026-10-01'
AUTONOX_API_URL=https://autonox.com.br/api/ingest/os

#CONNECTION EXTRACT
ORACLE_USERNAME=user
ORACLE_PASSWORD=password
ORACLE_HOST=ip_server
ORACLE_PORT=port
ORACLE_SERVICE=service_name

# DRIVER Instant Client Oracle — Windows (pasta local fora do Git; ver README)
#ORACLE_DRIVER=include\infra\oracle\instantclient_23_8

# DRIVER Instant Client Oracle — Linux / Astro (Dockerfile)
ORACLE_DRIVER=/opt/oracle/instantclient_23_9

#CONNECTION LOAD
POSTGRES_USERNAME=user_postgres
POSTGRES_PASSWORD=password_postgres
POSTGRES_HOST=192.168.1.10
POSTGRES_PORT=5433
POSTGRES_SERVICE=database_name
POSTGRES_PUBLISHED_PORT=5433
POSTGRES_BIND_ADDRESS=192.168.1.10

#AIRFLOW_PARAM__ALLOW_DESERIALIZATION
AIRFLOW__CORE__ALLOWED_DESERIALIZATION_CLASSES="include.data.schemas.*"